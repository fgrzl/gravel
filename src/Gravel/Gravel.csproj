<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Treat all warnings as errors for stricter CI and packaging -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <!-- Allow these documentation warnings to remain non-fatal (too many public members) -->
    <WarningsNotAsErrors>CS1591;CS1574;CS1573</WarningsNotAsErrors>

    <!-- Packaging / NuGet metadata -->
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>false</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/fgrzl/gravel</RepositoryUrl>

    <!-- Fill these values appropriately for your project -->
    <PackageId>Gravel</PackageId>
    <Version>0.1.0</Version>
    <Authors>fgrzl</Authors>
    <Company>fgrzl</Company>
    <Description>Small, fast SSTable-style storage primitives for .NET.</Description>
    <PackageProjectUrl>https://github.com/fgrzl/gravel</PackageProjectUrl>
    <PackageTags>sstable;storage;gravel;dotnet</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- Repository has an MIT license; declare it for NuGet consumers -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryBranch>develop</RepositoryBranch>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gravel.Tests" />
    <InternalsVisibleTo Include="Gravel.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.9" />
    <PackageReference Include="System.IO.Hashing" Version="9.0.9" />
  </ItemGroup>
</Project>